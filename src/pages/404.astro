---
// dist/404.html. Cloudflare Pages serves it with status 404 for any path that
// does not exist, including an unknown claim or assessment version.
import Base from "../layouts/Base.astro";
---
<Base title="Not found" description="There is no page at this address." noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>Not found</h1>
      <p class="lede">There is no page at this address.</p>
    </header>
    <div class="prose">
      <p>Try <a href="/search">search</a>, or browse <a href="/register/checked">every claim</a>. Claims that didn’t pass every check are on <a href="/held">the held-back list</a>.</p>
    </div>
  </div>
</Base>
