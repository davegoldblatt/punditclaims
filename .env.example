# Names only. Values live in the operator's keychain or the CI secret store.
# Anthropic: an API key, or the Claude Code subscription login (CLAUDE_CODE_OAUTH_TOKEN).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# OpenAI: an API key, or a Codex CLI login directory holding auth.json.
OPENAI_API_KEY=
CODEX_HOME=
# Spend ceiling in US dollars for API-billed runs. Required and positive for any API-billed run.
PC_SPEND_CEILING_USD=
# Where full private source text is kept. Defaults to .cache/private-sources (gitignored).
PC_PRIVATE_DIR=
# Public origin. Set it only for a real deployment: pages ask to be indexed only when it is set.
PC_SITE_ORIGIN=https://punditclaims.ai
